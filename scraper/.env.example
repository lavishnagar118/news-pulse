# News Pulse Scraper & Ingestion Cloud Service Configuration

# MongoDB Connection String (Local MongoDB or MongoDB Atlas SRV)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/news_pulse?retryWrites=true&w=majority

# Logging & Network Settings
LOG_LEVEL=INFO
REQUEST_TIMEOUT=15
SCRAPER_USER_AGENT=NewsPulseBot/1.0 (+https://github.com/example/news-pulse; contact@newspulse.internal)
MAX_CONTENT_BYTES=5242880

# Topic Clustering Parameters (Deterministic TF-IDF + Agglomerative clustering)
SIMILARITY_THRESHOLD=0.12
TFIDF_MAX_DF=0.85
TFIDF_MIN_DF=1
TFIDF_NGRAM_MAX=2

# Optional AI Configuration (Disabled in production; core system is 100% deterministic)
AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Shared Authentication Secret for Ingestion Service (POST /run)
INGESTION_SERVICE_SECRET=your-shared-secret-here

# Cloud Service Host & Port (for Render deployment)
PORT=8000
HOST=0.0.0.0
