# ==============================================================================
# News Pulse — Environment Configuration Template
# Copy this file to .env or configure in your deployment environment.
# ==============================================================================

# MongoDB Connection String (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/news_pulse

# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Scraper Runner Mode: 'subprocess' (local) or 'http' (cloud/Render)
SCRAPER_MODE=subprocess
SCRAPER_SERVICE_URL=http://localhost:8000
INGESTION_SERVICE_SECRET=your-secure-ingestion-secret

# Python Executable Paths (for subprocess mode)
PYTHON_BIN=python
PYTHON_SCRAPER_PATH=../scraper/main.py

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000
