# News Pulse Backend Configuration

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=production

# MongoDB Connection String (Local MongoDB or MongoDB Atlas SRV)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/news_pulse?retryWrites=true&w=majority

# Allowed CORS Origin for Frontend Client (supports comma-separated origins, e.g. http://localhost:3000,https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Scraper Invocation Mode: subprocess (local dev) | http (cloud deployment)
SCRAPER_MODE=http

# External Scraper Service URL (required when SCRAPER_MODE=http)
SCRAPER_SERVICE_URL=http://localhost:8000

# Shared Authentication Secret for Ingestion Service
INGESTION_SERVICE_SECRET=your-shared-secret-here

# Local Development Subprocess Runner Settings (used when SCRAPER_MODE=subprocess)
PYTHON_BIN=python
PYTHON_SCRAPER_PATH=../scraper/main.py
